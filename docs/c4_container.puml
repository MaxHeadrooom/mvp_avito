@startuml
title Авито.Кухня — C4 Level 2 (containers)
left to right direction
skinparam componentStyle rectangle

actor "Пользователь" as user
actor "Сотрудник\nзаведения" as staff
rectangle "Авито.Кухня" {
  component "Web-клиент\n(вне scope)" as web
  component "Kitchen Core API\nFastAPI" as core
  database "PostgreSQL" as db
}
component "Establishment Service\nFlask, пример партнёра" as partner

user --> web : выбирает и заказывает
web --> core : client API / JSON HTTPS
core --> db : SQL
core --> partner : webhook нового заказа
partner --> core : partner API / JSON HTTPS
staff --> partner : API оператора
@enduml

