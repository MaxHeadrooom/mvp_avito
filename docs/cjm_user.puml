@startuml
title CJM пользователя — заказ в Авито.Кухня

start
:Открывает Авито.Кухня;
:Получает список открытых заведений;
:Выбирает заведение и смотрит меню;

if (Позиция доступна и есть остаток?) then (да)
  :Добавляет позиции и адрес доставки;
else (нет)
  :Видит недоступность или нулевой остаток;
  :Выбирает другую позицию;
endif

:Оформляет заказ;
if (Заведение закрыто или остатка уже нет?) then (да)
  :Получает 409 и корректирует заказ;
  stop
else (нет)
  :Видит статус created;
endif

if (Нужно отменить до принятия?) then (да)
  :Отменяет заказ;\nрезерв возвращается;
  stop
endif

:Периодически получает статус и историю;
if (Заведение отказало?) then (да)
  :Видит причину отказа;
  stop
else (нет)
  :Видит accepted → preparing → ready;
  :Получает заказ;\nстатус completed;
endif
stop
@enduml

